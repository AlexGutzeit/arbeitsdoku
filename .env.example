# Beispiel-Konfiguration — kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# Port, auf dem der Server lauscht
PORT=3000

# Pfad zur SQLite-Datenbankdatei (wird beim ersten Start automatisch angelegt)
DB_PATH=./data/arbeitsdoku.db

# Geheimer Schlüssel zum Signieren der JWT-Tokens.
# PFLICHT in Produktion — der Server startet ohne (zu kurzen) Wert nicht.
# Sicheren Wert erzeugen z. B. mit:  openssl rand -base64 48
JWT_SECRET=bitte-einen-langen-zufaelligen-wert-eintragen

# Optional: Pfad zu einer Chromium/Chrome-Binary für die Browser-Tests (Puppeteer).
# Nur für `node tests/browser-smoke.js` nötig, nicht für den Server.
# CHROME_BIN=/usr/bin/chromium

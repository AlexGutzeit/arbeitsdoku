# Beispiel-Konfiguration — kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# Port, auf dem der Server lauscht
PORT=3000

# Pfad zur SQLite-Datenbankdatei (wird beim ersten Start automatisch angelegt)
DB_PATH=./data/arbeitsdoku.db

# Geheimer Schlüssel zum Signieren der JWT-Tokens.
# PFLICHT in Produktion — der Server startet ohne (zu kurzen) Wert nicht.
# Sicheren Wert erzeugen z. B. mit:  openssl rand -base64 48
JWT_SECRET=bitte-einen-langen-zufaelligen-wert-eintragen

# Zwei-Faktor-Anmeldung (TOTP): Schluessel, mit dem die Authenticator-Geheimnisse in der
# Datenbank verschluesselt werden. 32 Byte als hex oder base64, z. B.:
#   openssl rand -base64 32
# Fehlt der Wert, wird ersatzweise einer aus JWT_SECRET abgeleitet — dann gilt: Wer JWT_SECRET
# austauscht, macht damit ALLE Authenticator-Einrichtungen ungueltig (der Admin muss dann fuer
# jeden zuruecksetzen). Fuer den Produktivbetrieb daher setzen und wie JWT_SECRET sichern.
# WICHTIG: Der Wert gehoert auf JEDE Anlage, auch auf die Zweitanlage — er liegt NICHT im Backup.
TWOFA_KEY=

# NOTFALL-SCHALTER. Auf 1 gesetzt wird kein zweiter Faktor mehr verlangt: kein Code beim Anmelden,
# keine erzwungene Einrichtung. Es wird nichts geloescht — Variable wieder entfernen, Dienst neu
# starten, alles greift wie zuvor. Das ist der Weg zurueck, wenn sich jemand ausgesperrt hat oder
# TWOFA_KEY verloren ging.
TWOFA_AUS=

# Web-Push (Handy-/Desktop-Benachrichtigungen auch bei geschlossener App).
# Schlüsselpaar einmalig erzeugen mit:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# Fehlen diese Werte, ist Push einfach inaktiv (sauberer Fallback, kein Crash).
# VAPID_SUBJECT muss eine mailto:- oder https:-Kontaktangabe sein.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:admin@example.com

# Optional: Pfad zu einer Chromium/Chrome-Binary für die Browser-Tests (Puppeteer).
# Nur für `node tests/browser-smoke.js` nötig, nicht für den Server.
# CHROME_BIN=/usr/bin/chromium
